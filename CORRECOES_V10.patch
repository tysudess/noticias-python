     def _start_crop(self) -> None:
         index = self.model.selected_index
         if index not in range(len(self.model.pages)):
             QMessageBox.critical(self, "Editor de PDF", "Selecione uma página para recortar.")
             return
+
+        # O corte precisa ter prioridade sobre qualquer preview anterior.
+        # O bug anterior acontecia porque _run_image_worker incrementava o token
+        # novamente quando uma renderização ainda estava ativa. Assim, o worker
+        # do próprio corte nascia com um token que já estava inválido e
+        # preview.begin_crop(...) nunca era executado.
         self._preview_token += 1
         token = self._preview_token
         page = self.model.pages[index]
+
+        self.status.setText(
+            "Preparando recorte... depois clique e arraste sobre a área que deseja manter."
+        )
+
         self._run_image_worker(
             token,
             lambda: self.model.render_transformed_source(page, 120),
-            lambda image: self.preview.begin_crop(image, self.model.zoom, page.crop),
+            lambda image: self._begin_crop_ready(image, page.crop),
         )

+    def _begin_crop_ready(self, image: QImage, existing_crop: PdfCrop | None) -> None:
+        self.preview.begin_crop(
+            image,
+            self.model.zoom,
+            existing_crop,
+        )
+        self.preview.setFocus(Qt.FocusReason.OtherFocusReason)
+        self.status.setText(
+            "MODO CORTAR ATIVO — clique e arraste sobre a página; ao soltar, o recorte será aplicado."
+        )
+
     def _crop_done(self, crop: PdfCrop) -> None:
         if self.model.apply_crop(crop):
+            self.status.setText(
+                "Recorte aplicado. Use Ctrl+Z para desfazer."
+            )
             self._refresh_all()

     def _run_image_worker(self, token: int, fn, on_done=None) -> None:
-        if self._preview_thread is not None and self._preview_thread.isRunning():
-            self._preview_token += 1
+        # NÃO alterar o token aqui.
+        #
+        # O chamador já cria um token novo antes de iniciar o worker.
+        # Incrementar novamente neste ponto invalidava exatamente o worker
+        # recém-criado quando outro preview ainda estava terminando, quebrando
+        # principalmente o botão "Cortar".
         thread = QThread(self)
         worker = _ImageWorker(token, fn)
         worker.moveToThread(thread)
         thread.started.connect(worker.run)
