+    def _start_crop(self) -> None:
+        """Inicia o corte sem disputar o token do worker da prévia.
+
+        A versão anterior podia invalidar o próprio token do recorte quando
+        ainda existia uma renderização da prévia em andamento. O resultado era
+        clicar em "Cortar" e aparentemente não acontecer nada.
+        """
+        index = self.model.selected_index
+
+        if index not in range(len(self.model.pages)):
+            QMessageBox.critical(
+                self,
+                "Editor de PDF",
+                "Selecione uma página para recortar.",
+            )
+            return
+
+        page = self.model.pages[index]
+
+        try:
+            image = _pil_to_qimage(
+                self.model.render_transformed_source(
+                    page,
+                    120,
+                )
+            )
+        except Exception as exc:
+            QMessageBox.critical(
+                self,
+                "Editor de PDF",
+                f"Não foi possível preparar o recorte: {exc}",
+            )
+            return
+
+        self.preview.begin_crop(
+            image,
+            self.model.zoom,
+            page.crop,
+        )
+        self.preview.setFocus()
+        self.status.setText(
+            "Cortar: clique e arraste sobre a área que deseja manter."
+        )
+
+    def _crop_done(self, crop) -> None:
+        if self.model.apply_crop(crop):
+            self.status.setText(
+                "Recorte aplicado. Use Ctrl+Z para desfazer."
+            )
+            self._refresh_all()
