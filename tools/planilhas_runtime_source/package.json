{
  "name": "automacao-planilhas",
  "version": "1.0.4",
  "description": "Automação WhatsApp para Google Planilhas - Windows Portable",
  "main": "main.js",
  "author": "RODRIGODESS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never",
    "patch:wwebjs": "node scripts/patch-whatsapp-web.js",
    "dist:patched": "npm run patch:wwebjs && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "axios": "1.11.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.com.automacaoplanilhas",
    "productName": "Automacao Planilhas",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.default.json"
      },
      {
        "from": "chrome-portable",
        "to": "chrome-portable",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AutomacaoPlanilhas-Windows-Portable-v${version}.exe"
    }
  }
}
